# === §17: app (Bot/Web) が読む環境変数。必須7つ + 任意2つのみ ===

# Discord Developer Portal > Bot > Token
DISCORD_TOKEN=

# Discord Developer Portal > OAuth2 > Client ID / Client Secret
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 認証サイトのURL(https)。Cloudflare Tunnelに割り当てたドメイン。
BASE_URL=https://verify.example.com

# Cloudflare Dashboard > Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostgreSQL接続文字列。sslmode=require を付ける(§11.2)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# state署名用。32バイト以上のランダム値。例: `openssl rand -base64 32`
STATE_HMAC_KEY=

# フィールド暗号化キー。書式: "1:base64(32byteキー)"。例:
#   openssl rand -base64 32
# 複数指定するとローテーション可(先頭が現用キー、§11.1)。例: "2:xxxx,1:yyyy"
DATA_ENC_KEYS=

# --- 任意 ---

# proxycheck.io の登録キー(§7)。未設定でも未登録枠(100クエリ/日)で動作する
PROXYCHECK_API_KEY=

# 待受ポート。既定 3000
PORT=3000

# === §5.3: CLOUDFLARE_TUNNEL_TOKEN はこのファイルに入れない ===
# app が読むのはこの9個のみ。トークンは ./.env (このファイルではなく
# プロジェクト直下の .env)で管理する。詳しくは .env.example を参照。
